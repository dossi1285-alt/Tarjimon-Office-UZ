<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <OutputName>TarjimonOfficeUZ</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <DefineConstants>$(DefineConstants);ProductVersion=1.1.1</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TarjimonOfficeUZ.Word\TarjimonOfficeUZ.Word.csproj" />
    <ProjectReference Include="..\TarjimonOfficeUZ.Excel\TarjimonOfficeUZ.Excel.csproj" />

    <!-- The installer UI is owned by OwnOnlyInstaller.exe.
         Ignore any stale local CustomUI authoring left from the earlier
         experimental WixUI implementation so it cannot break the MSI build. -->
    <Compile Remove="TarjimonOfficeUZ.CustomUI.wxs" />
    <Compile Remove="**\TarjimonOfficeUZ.CustomUI.wxs" />
  </ItemGroup>
</Project>
