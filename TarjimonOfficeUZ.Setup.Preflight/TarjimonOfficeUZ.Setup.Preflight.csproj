<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>TarjimonOfficeUZ.Setup.Preflight</RootNamespace>
    <AssemblyName>TarjimonOfficeUZSetup</AssemblyName>
    <StartupObject>TarjimonOfficeUZ.Setup.Preflight.OwnOnlyInstaller</StartupObject>
    <MsiSource>..\TarjimonOfficeUZ.Setup.Wix\bin\Debug\TarjimonOfficeUZ.msi</MsiSource>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>9.0</LangVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <AssemblyTitle>Tarjimon Office UZ</AssemblyTitle>
    <AssemblyProduct>Tarjimon Office UZ</AssemblyProduct>
    <AssemblyCompany>Dostonjon Ashurov</AssemblyCompany>
    <Description>Microsoft Office tarjimonlarini aniqlash va boshqarish vositasi.</Description>
    <Copyright>© 2026 Dostonjon Ashurov</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Program.cs" />
    <Compile Remove="ProgramV110.cs" />
    <Compile Remove="DisplayFilterRuntime.cs" />
  </ItemGroup>

  <!-- Build the WiX MSI before CoreCompile. The freshly built MSI is then embedded. -->
  <Target Name="BuildCurrentWixMsi" BeforeTargets="CoreCompile">
    <MSBuild Projects="$(MSBuildProjectDirectory)\..\TarjimonOfficeUZ.Setup.Wix\TarjimonOfficeUZ.Setup.Wix.wixproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);Platform=x64" />
    <ItemGroup>
      <EmbeddedResource Include="$(MsiSource)">
        <LogicalName>TarjimonOfficeUZSetup.msi</LogicalName>
        <Type>Non-Resx</Type>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

  <Target Name="CopyFinalSetupToRepositoryRoot" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(MSBuildProjectDirectory)\..\TarjimonOfficeUZSetup.exe" SkipUnchangedFiles="false" />
  </Target>
</Project>
