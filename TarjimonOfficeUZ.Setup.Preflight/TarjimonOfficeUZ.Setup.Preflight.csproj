<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>TarjimonOfficeUZ.Setup.Preflight</RootNamespace>
    <AssemblyName>TarjimonOfficeUZSetup</AssemblyName>
    <StartupObject>TarjimonOfficeUZ.Setup.Preflight.InstallerFlow</StartupObject>
    <MsiSource>..\TarjimonOfficeUZ.Setup.Wix\bin\$(Configuration)\TarjimonOfficeUZ.msi</MsiSource>
    <UninstallerSource>..\TarjimonOfficeUZ.Uninstaller\bin\$(Configuration)\net8.0-windows\publish\TarjimonOfficeUZUninstaller.exe</UninstallerSource>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>9.0</LangVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <AssemblyTitle>Tarjimon Office UZ</AssemblyTitle>
    <AssemblyProduct>Tarjimon Office UZ</AssemblyProduct>
    <AssemblyCompany>Dostonjon Ashurov</AssemblyCompany>
    <Description>Microsoft Office tarjimonlarini aniqlash va boshqarish vositasi.</Description>
    <Copyright>© 2026 Dostonjon Ashurov</Copyright>
    <Version>$(TarjimonProductVersion)</Version>
    <AssemblyVersion>$(TarjimonProductVersion).0</AssemblyVersion>
    <FileVersion>$(TarjimonProductVersion).0</FileVersion>
    <InformationalVersion>$(TarjimonProductVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Program.cs" />
    <Compile Remove="ProgramV110.cs" />
    <Compile Remove="DisplayFilterRuntime.cs" />
    <Compile Remove="OwnOnlyInstaller.cs" />
  </ItemGroup>

  <Target Name="BuildEmbeddedUninstaller" BeforeTargets="PrepareResources">
    <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)\..\TarjimonOfficeUZ.Uninstaller\TarjimonOfficeUZ.Uninstaller.csproj&quot; -c $(Configuration) -r win-x64 --self-contained true -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -p:PublishTrimmed=false -p:TarjimonUninstallerPublishRunning=true -p:PublishDir=&quot;$(MSBuildProjectDirectory)\..\TarjimonOfficeUZ.Uninstaller\bin\$(Configuration)\net8.0-windows\publish\&quot; --nologo" />
    <Error Condition="!Exists('$(UninstallerSource)')" Text="Uninstaller build output topilmadi: $(UninstallerSource)" />
  </Target>

  <Target Name="BuildEmbeddedMsi" BeforeTargets="PrepareResources">
    <MSBuild
      Projects="..\TarjimonOfficeUZ.Setup.Wix\TarjimonOfficeUZ.Setup.Wix.wixproj"
      Targets="Build"
      Properties="Configuration=$(Configuration);Platform=x64" />
    <Error Condition="!Exists('$(MsiSource)')"
           Text="MSI build output topilmadi: $(MsiSource)" />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="$(MsiSource)">
      <LogicalName>TarjimonOfficeUZSetup.msi</LogicalName>
      <Type>Non-Resx</Type>
    </EmbeddedResource>
    <EmbeddedResource Include="$(UninstallerSource)">
      <LogicalName>TarjimonOfficeUZUninstaller.exe</LogicalName>
      <Type>Non-Resx</Type>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="CopyFinalSetupToRepositoryRoot" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(MSBuildProjectDirectory)\..\TarjimonOfficeUZSetup.exe" SkipUnchangedFiles="false" />
  </Target>
</Project>
