<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>TarjimonOfficeUZUninstaller</AssemblyName>
    <RootNamespace>TarjimonOfficeUZ.Uninstaller</RootNamespace>
    <AssemblyTitle>Tarjimon Office UZ — Удаление</AssemblyTitle>
    <Product>Tarjimon Office UZ</Product>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>

    <!-- The uninstaller must run on a PC without .NET installed. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <PublishSingleFile>true</PublishSingleFile>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <!-- A normal Rebuild is enough for the solution workflow: after the project
       builds, publish the actual native EXE into a separate publish folder. -->
  <Target Name="PublishNativeUninstaller" AfterTargets="Build" Condition="'$(TarjimonUninstallerPublishRunning)' != 'true'">
    <Exec Command="dotnet publish &quot;$(MSBuildProjectFullPath)&quot; -c $(Configuration) -r win-x64 --self-contained true -p:PublishAot=true -p:PublishSingleFile=true -p:StripSymbols=true -p:TarjimonUninstallerPublishRunning=true -p:PublishDir=&quot;$(ProjectDir)bin\$(Configuration)\net8.0-windows\publish\&quot; --nologo" />
  </Target>
</Project>
