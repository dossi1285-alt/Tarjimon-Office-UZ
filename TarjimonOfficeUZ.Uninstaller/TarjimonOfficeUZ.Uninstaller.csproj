<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>TarjimonOfficeUZUninstaller</AssemblyName>
    <RootNamespace>TarjimonOfficeUZ.Uninstaller</RootNamespace>
    <AssemblyTitle>Tarjimon Office UZ — Удаление</AssemblyTitle>
    <Product>Tarjimon Office UZ</Product>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <Target Name="PublishStandaloneUninstaller" AfterTargets="Build" Condition="'$(TarjimonUninstallerPublishRunning)' != 'true'">
    <PropertyGroup>
      <_UninstallerPublishDir>$(MSBuildProjectDirectory)\obj\$(Configuration)\net8.0-windows\standalone\</_UninstallerPublishDir>
    </PropertyGroup>
    <Exec Command="dotnet publish &quot;$(MSBuildProjectFullPath)&quot; -c $(Configuration) -r win-x64 --self-contained true -p:PublishSingleFile=true -p:PublishTrimmed=false -p:TarjimonUninstallerPublishRunning=true -p:PublishDir=&quot;$(_UninstallerPublishDir)&quot; --nologo" />
    <Copy SourceFiles="$(_UninstallerPublishDir)$(AssemblyName).exe" DestinationFiles="$(TargetDir)$(AssemblyName).exe" SkipUnchangedFiles="false" />
  </Target>
</Project>
